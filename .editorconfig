root = true

# C# files
[*.cs]
charset = utf-8
indent_size = 4
indent_style = space
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# XML files
[*.csproj]
[*.sln]
[*.props]
[*.xml]
charset = utf-8
indent_size = 2
indent_style = space
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
charset = utf-8
indent_size = 2
indent_style = space
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JSON files
[*.json]
charset = utf-8
indent_size = 2
indent_style = space
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# YAML files
[*.yml]
[*.yaml]
charset = utf-8
indent_size = 2
indent_style = space
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
